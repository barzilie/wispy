# WiSpy Configuration Template
# Copy this file to .env and fill in your values

# Mock Mode (auto-detected by default)
# true = Use mock data (for macOS development)
# false = Use real scanner (for Kali Linux)
# Leave commented out for auto-detection based on platform
# WISPY_MOCK_MODE=true

# Google API Key (for AI recommendations)
# Get your key from: https://aistudio.google.com/
GOOGLE_API_KEY=your-api-key-here

# WiFi Interface (only used in real mode on Kali)
WIFI_INTERFACE=wlan0

# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
